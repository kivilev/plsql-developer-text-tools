root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.cs]
# Layout
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true

# Language
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_prefer_braces = when_multiline:warning
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Naming: private static fields are PascalCase or _camelCase, both used for readability of readonly tables.
dotnet_naming_style.pascal.capitalization = pascal_case

# Code quality rules raised to build errors (with TreatWarningsAsErrors)
dotnet_diagnostic.IDE0005.severity = warning   # unused usings
dotnet_diagnostic.IDE0161.severity = warning   # file-scoped namespace
dotnet_diagnostic.CA1305.severity = warning    # culture-specific formatting must be explicit
dotnet_diagnostic.CA1307.severity = warning    # string comparison must be explicit
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA2000.severity = warning    # dispose objects

# Noise for this project
dotnet_diagnostic.CA1515.severity = none       # public types in a library are intended
dotnet_diagnostic.MA0048.severity = none       # file name must match type name: several small records per file are fine
dotnet_diagnostic.MA0051.severity = none       # method too long: parsers are deliberately linear
dotnet_diagnostic.S1135.severity = none        # TODO comments are tracked in issues

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none       # test names may use underscores
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.S2699.severity = none        # Sonar: tests without explicit asserts (Assert.Throws inside helpers)

# Interop needs unsafe code (function pointers, char*): that is the point of these projects.
[{src/TextTools.Plugin/**.cs,tools/**.cs}]
dotnet_diagnostic.S6640.severity = none

# The emulator is a test harness: forced GC to measure memory, a seeded Random for reproducible stress runs,
# synchronous console I/O, callbacks that must be methods.
[tools/**.cs]
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.S1215.severity = none
dotnet_diagnostic.S2245.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.S6966.severity = none
dotnet_diagnostic.S3400.severity = none
