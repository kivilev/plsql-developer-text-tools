<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PlsqlDevTextTools</AssemblyName>
    <RootNamespace>TextTools.Plugin</RootNamespace>

    <!-- Native AOT shared library: a plain x64 DLL with C exports, no CLR loaded into PL/SQL Developer. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextTools.Core\TextTools.Core.csproj" />
    <InternalsVisibleTo Include="TextTools.Plugin.Tests" />
  </ItemGroup>

</Project>
