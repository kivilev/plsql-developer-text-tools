<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure text transformations, no IDE dependencies. Everything testable lives here. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Texts per IDE language: data, not code. WithCulture=false: ".de" in the name is our language code, not a satellite-assembly culture. -->
    <EmbeddedResource Include="Menu/captions.*.json" WithCulture="false" />
    <EmbeddedResource Include="Ui/texts*.json" WithCulture="false" />
    <!-- Extended Explain Plan texts: reference.json (English) and reference.<code>.json (one per IDE translation). -->
    <EmbeddedResource Include="Plan/reference*.json" WithCulture="false" />
  </ItemGroup>

</Project>
