<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure text transformations, no IDE dependencies. Everything testable lives here. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Menu captions per IDE language: data, not code. WithCulture=false: ".de" in the name is our language code, not a satellite-assembly culture. -->
    <EmbeddedResource Include="Menu/captions.*.json" WithCulture="false" />
  </ItemGroup>

</Project>
