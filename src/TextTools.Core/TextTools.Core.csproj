<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure text transformations, no IDE dependencies. Everything testable lives here. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Extended Explain Plan reference and rule texts: data, not code. -->
    <!-- reference.json (English) and reference.<code>.json (one per IDE translation); resource names TextTools.Core.Plan.reference[.<code>].json. -->
    <!-- WithCulture=false: ".de" in the file name is a language code of ours, not a satellite-assembly culture. -->
    <EmbeddedResource Include="Plan/reference*.json" WithCulture="false" />
  </ItemGroup>

</Project>
